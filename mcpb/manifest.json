{
  "$schema": "https://raw.githubusercontent.com/anthropics/mcpb/main/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "photoshop-mcp",
  "display_name": "Photoshop MCP",
  "version": "0.0.0",
  "description": "MCP server for Adobe Photoshop — tools, recipes, generative AI, and standalone UI.",
  "long_description": "Control Adobe Photoshop from AI assistants (Cursor, Claude Desktop, etc.). Requires Photoshop running on macOS or Windows and Node.js 18+.",
  "author": {
    "name": "Ali Sait Teke",
    "url": "https://alisait.com"
  },
  "homepage": "https://github.com/alisaitteke/photoshop-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/alisaitteke/photoshop-mcp"
  },
  "documentation": "https://github.com/alisaitteke/photoshop-mcp#readme",
  "support": "https://github.com/alisaitteke/photoshop-mcp/issues",
  "license": "MIT",
  "keywords": ["mcp", "photoshop", "adobe", "image-editing", "automation"],
  "server": {
    "type": "node",
    "entry_point": "server/dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/dist/index.js"],
      "env": {
        "LOG_LEVEL": "${user_config.logLevel}",
        "PHOTOSHOP_PATH": "${user_config.photoshopPath}"
      }
    }
  },
  "user_config": {
    "logLevel": {
      "type": "string",
      "title": "Log level",
      "description": "0=DEBUG, 1=INFO, 2=WARN, 3=ERROR",
      "default": "1",
      "enum": ["0", "1", "2", "3"]
    },
    "photoshopPath": {
      "type": "string",
      "title": "Photoshop install path",
      "description": "Optional. Leave empty to auto-detect the local Photoshop install.",
      "required": false
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": ["darwin", "win32"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "tools_generated": true,
  "prompts_generated": true
}
