# Optional: disable anonymous usage analytics
# ANALYTICS_DISABLED=1
# POSTHOG_DISABLED=1

# Rybbit (defaults are embedded in src/analytics/config.ts)
# RYBBIT_API_KEY=rb_your_ingest_key
# RYBBIT_HOST=https://hey.sideguard.io
# RYBBIT_SITE_ID=5e488c650441

# Beta team content sharing (prompts/responses) is controlled via the UI consent
# modal and Settings → Privacy — there is no separate env flag.

# Optional: disable the MCP product-feedback ping question (on by default)
# PSMCP_FEEDBACK=0

# Optional: disable the daily npm version check and the ping update notice (on by default)
# PSMCP_UPDATE_CHECK=0

# Existing server options
# PHOTOSHOP_PATH=/Applications/Adobe Photoshop 2025/Adobe Photoshop 2025.app/Contents/MacOS/Adobe Photoshop 2025
# PHOTOSHOP_SCRIPT_TIMEOUT=30000
# LOG_LEVEL=1
